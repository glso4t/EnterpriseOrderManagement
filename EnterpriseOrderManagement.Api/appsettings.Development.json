{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "EnterpriseOrderManagement.Api": "Debug"
    }
  },
  "InventorySettings": {
    "LowStockThreshold": 2
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
